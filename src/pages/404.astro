---
import Layout from '../layouts/Layout.astro';
import Scene from '../components/Scene.astro';
import Button from '../components/Button.astro';
---
<Layout title="A small detour">
  <section class="container not-found">
    <p class="eyebrow">A SMALL DETOUR</p>
    <h1>404</h1>
    <Scene variant="accent"/>
    <h2>This page has<br/>
      <em>stepped out for a moment.</em>
    </h2>
    <p>Let’s get you back to something familiar.</p>
  <Button href="/">Back to the studio</Button>
  </section>
</Layout>
