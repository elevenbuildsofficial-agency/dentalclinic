---
import Icon from './Icon.astro';
import { faqs } from '../clinic.config';
interface Props {
  items?: (readonly string[])[];
}
const { items = faqs } = Astro.props;
---
<div class="faq-list">{items.map(([question, answer], i) =>
    <details class="faq-item">
      <summary>
        <span class="faq-number">{String(i + 1).padStart(2, '0')}</span>
        <span>{question}</span>
        <Icon name="plus" size={20}/>
      </summary>
      <div class="faq-answer">
        <p>{answer}</p>
      </div>
    </details>)}</div>
