---
import Scene from './Scene.astro';
import Button from './Button.astro';
interface Props {
  eyebrow: string;
  title: string;
  accent?: string;
  description?: string;
  scene?: boolean;
  sceneVariant?: 'accent' | 'implant' | 'aligner';
  cta?: string;
}
const { eyebrow, title, accent, description, scene, cta, sceneVariant = 'accent' } = Astro.props;
---
<section class="page-hero">
  <div class="container">
    <div class="breadcrumbs">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span>{eyebrow}</span>
    </div>
    <div class:list={{ 'page-hero-grid': scene }}>
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h1 data-headline>{title}{accent && <>
              <br/>
              <em>{accent}</em>
            </>}</h1>{description && <p class="lede" data-reveal>{description}</p>}{cta && <Button href="/book/">{cta}</Button>}</div>{scene && <Scene variant={sceneVariant}/>}</div>
  </div>
</section>
